{
  "schemaVersion": 1,
  "id": "gearstatus",
  "version": "${version}",
  "name": "GearStatus",
  "description": "Minimalist modern armor and held-item durability HUD with dynamic health percentage colors.",
  "authors": [
    "shiaaliremains-commits"
  ],
  "contact": {
    "homepage": "https://github.com/shiaaliremains-commits/GearStatusMod",
    "sources": "https://github.com/shiaaliremains-commits/GearStatusMod"
  },
  "license": "CC0-1.0",
  "icon": "assets/gearstatus/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "my.gearstatus.Gearstatus"
    ],
    "client": [
      "my.gearstatus.client.GearstatusClient"
    ]
  },
  "mixins": [
    "gearstatus.mixins.json",
    {
      "config": "gearstatus.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
